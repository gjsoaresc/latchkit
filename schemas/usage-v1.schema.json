{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gjsoaresc/latchkit/schemas/usage-v1.schema.json",
  "title": "Latchkit local opt-in usage accounting v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "revision", "settings", "createdAt", "updatedAt", "records"],
  "properties": { "schemaVersion": { "const": 1 }, "project": { "type": "object" }, "revision": { "type": "integer", "minimum": 0 }, "settings": { "type": "object" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }, "records": { "type": "array" } }
}
