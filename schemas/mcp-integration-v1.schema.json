{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gjsoaresc/latchkit/schemas/mcp-integration-v1.schema.json",
  "title": "Latchkit managed MCP integration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "transport", "providers", "scope", "requiredEnvironment", "enabled"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "transport": { "enum": ["stdio", "http", "sse"] },
    "endpoint": { "type": "string" }, "executable": { "type": "string" },
    "args": { "type": "array", "items": { "type": "string" } },
    "providers": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "scope": { "const": "project" },
    "requiredEnvironment": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }, "uniqueItems": true },
    "toolAllowlist": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "enabled": { "type": "boolean" }
  }
}
