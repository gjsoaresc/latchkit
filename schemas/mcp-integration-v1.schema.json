{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/willahealm/latchkit/schemas/mcp-integration-v1.schema.json",
  "title": "Latchkit optional managed MCP definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "transport", "providers", "scope", "requiredEnvironment"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "transport": { "enum": ["stdio", "http", "sse"] },
    "endpoint": {
      "type": "string",
      "format": "uri",
      "maxLength": 4096,
      "pattern": "^https?://[^?#]+$"
    },
    "executable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "args": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 4096, "pattern": "^[^\\r\\n\\u0000]*$" }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
      "uniqueItems": true
    },
    "scope": { "const": "project" },
    "requiredEnvironment": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
      "uniqueItems": true
    },
    "toolAllowlist": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,127}$" },
      "uniqueItems": true,
      "description": "Representable for import, but activation is refused until provider-runtime enforcement is implemented."
    },
    "enabled": { "type": "boolean", "default": false }
  },
  "oneOf": [
    {
      "properties": { "transport": { "const": "stdio" } },
      "required": ["executable"],
      "not": { "required": ["endpoint"] }
    },
    {
      "properties": { "transport": { "enum": ["http", "sse"] } },
      "required": ["endpoint"],
      "not": { "anyOf": [{ "required": ["executable"] }, { "required": ["args"] }] }
    }
  ]
}
