{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gjsoaresc/latchkit/schemas/acceptance-checks-v1.schema.json",
  "title": "Latchkit acceptance checks v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "checks": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan"],
      "properties": {
        "plan": { "$ref": "#/$defs/plan" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "portEnvironment": { "type": "string", "minLength": 1 },
        "readinessPath": { "type": "string", "minLength": 1 },
        "readinessTimeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "type": "string", "minLength": 1 } }
    },
    "check": {
      "type": "object",
      "required": ["id", "criterionId", "label", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "criterionId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["cli", "http", "browser", "manual"] },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "outputLimitBytes": { "type": "integer", "minimum": 1 },
        "fixture": { "$ref": "#/$defs/fixture" },
        "plan": { "$ref": "#/$defs/plan" },
        "target": { "type": "string", "format": "uri" },
        "method": { "type": "string" },
        "body": { "type": "string" },
        "followRedirects": { "type": "boolean" },
        "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } },
        "actions": { "type": "array", "items": { "type": "object" } },
        "browser": { "enum": ["chromium", "firefox", "webkit"] },
        "captureScreenshot": { "type": "boolean" },
        "captureTrace": { "type": "boolean" },
        "instructions": { "type": "string", "minLength": 1 }
      }
    }
  }
}
