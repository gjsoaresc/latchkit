{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gjsoaresc/latchkit/schemas/manifest-v1.schema.json",
  "title": "Latchkit ownership manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "files": {
      "type": "object",
      "propertyNames": {
        "pattern": "^\\.(?:agents|claude)/skills/latchkit-(?:spec|fix|review|handoff)/SKILL\\.md$"
      },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  }
}
