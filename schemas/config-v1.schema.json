{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gjsoaresc/latchkit/schemas/config-v1.schema.json",
  "title": "Latchkit project configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providers", "skills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "providers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["claude", "codex", "antigravity", "cursor", "cursor-cli"] }
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["requirements", "spec", "build", "fix", "review", "handoff", "setup"] }
    }
  }
}
