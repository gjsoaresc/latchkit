{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gjsoaresc/latchkit/schemas/task-state-v4.schema.json",
  "title": "Latchkit local task state v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "revision", "createdAt", "updatedAt", "tasks"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "project": { "$ref": "task-state-v1.schema.json#/properties/project" },
    "revision": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "state",
        "revision",
        "createdAt",
        "updatedAt",
        "authorizationRequired",
        "authorizations",
        "owner",
        "criteria",
        "runs",
        "checkpoints",
        "evidence",
        "events",
        "import",
        "enhancedWorkflow",
        "verificationMode",
        "records"
      ],
      "properties": {
        "id": { "$ref": "task-state-v1.schema.json#/$defs/taskId" },
        "title": { "type": "string", "minLength": 1 },
        "state": {
          "enum": [
            "planned",
            "running",
            "awaiting-decision",
            "blocked",
            "cancelled",
            "completed",
            "verified"
          ]
        },
        "revision": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "authorizationRequired": { "type": "boolean" },
        "authorizations": {
          "type": "array",
          "items": { "$ref": "task-state-v1.schema.json#/$defs/authorization" }
        },
        "owner": { "$ref": "task-state-v1.schema.json#/$defs/owner" },
        "criteria": {
          "type": "array",
          "items": { "$ref": "task-state-v1.schema.json#/$defs/criterion" }
        },
        "runs": {
          "type": "array",
          "items": { "$ref": "task-state-v1.schema.json#/$defs/run" }
        },
        "checkpoints": {
          "type": "array",
          "items": { "$ref": "task-state-v1.schema.json#/$defs/checkpoint" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "task-state-v2.schema.json#/$defs/evidence" }
        },
        "events": {
          "type": "array",
          "items": { "$ref": "task-state-v1.schema.json#/$defs/event" }
        },
        "import": { "$ref": "task-state-v1.schema.json#/$defs/import" },
        "enhancedWorkflow": {
          "oneOf": [{ "type": "null" }, { "$ref": "enhanced-workflow-v1.schema.json" }]
        },
        "verificationMode": {
          "description": "Bounded, change-focused fast verification versus the full standard path. Persisted so resume never silently changes an existing task's verification behavior.",
          "enum": ["fast", "standard"]
        },
        "records": {
          "description": "Discriminated decision/assumption/observation/question knowledge records with explicit provenance. See docs/task-state.md.",
          "type": "array",
          "items": { "$ref": "#/$defs/record" }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "revision",
        "status",
        "text",
        "provenance",
        "links",
        "supersedes",
        "supersededBy",
        "history",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^record_[0-9a-fA-F-]{36}$" },
        "kind": { "enum": ["decision", "assumption", "observation", "question"] },
        "revision": { "type": "integer", "minimum": 1 },
        "status": {
          "description": "Kind-appropriate status. decision: proposed/accepted/retracted/superseded. assumption: tentative/confirmed/contradicted/retracted/superseded. observation: unverified/verified/stale/retracted/superseded. question: open/answered/withdrawn/superseded.",
          "type": "string"
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "provenance": { "$ref": "#/$defs/recordProvenance" },
        "links": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/recordLink" }
        },
        "supersedes": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^record_[0-9a-fA-F-]{36}$" }]
        },
        "supersededBy": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^record_[0-9a-fA-F-]{36}$" }]
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": { "$ref": "#/$defs/recordHistoryEntry" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "recordProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "enum": ["direct-user", "agent-inferred", "imported", "execution-observed"]
        },
        "reference": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "recordHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "status", "text", "action", "reason", "authorizationId", "createdAt"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "type": "string" },
        "text": { "type": "string" },
        "action": { "enum": ["created", "revised", "transitioned"] },
        "reason": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "authorizationId": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^authorization_[0-9a-fA-F-]{36}$" }
          ]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "recordLink": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "recordId", "recordRevision"],
          "properties": {
            "type": { "const": "record" },
            "recordId": { "type": "string", "pattern": "^record_[0-9a-fA-F-]{36}$" },
            "recordRevision": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "criterionId", "criterionRevision"],
          "properties": {
            "type": { "const": "criterion" },
            "criterionId": { "type": "string", "pattern": "^criterion_[0-9a-fA-F-]{36}$" },
            "criterionRevision": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "evidenceId"],
          "properties": {
            "type": { "const": "evidence" },
            "evidenceId": { "type": "string", "pattern": "^evidence_[0-9a-fA-F-]{36}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "memoryId", "memoryRevision"],
          "properties": {
            "type": { "const": "memory" },
            "memoryId": { "type": "string", "pattern": "^memory_[0-9a-fA-F-]{36}$" },
            "memoryRevision": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "digest", "observedAt"],
          "properties": {
            "type": { "const": "source" },
            "path": { "type": "string", "minLength": 1 },
            "digest": {
              "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }]
            },
            "observedAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    }
  }
}
