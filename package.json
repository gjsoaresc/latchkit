{
  "name": "latchkit",
  "version": "1.0.0",
  "description": "Your agents. One workflow. Open-source skills and local configuration for coding agents.",
  "type": "module",
  "license": "MIT",
  "author": "Guilherme Jacob",
  "repository": {
    "type": "git",
    "url": "https://github.com/willahealm/latchkit.git"
  },
  "bugs": "https://github.com/willahealm/latchkit/issues",
  "homepage": "https://github.com/willahealm/latchkit#readme",
  "bin": {
    "latchkit": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "npm run build && node dist/src/cli.js ui",
    "tools:compile": "node node_modules/typescript/bin/tsc --project tsconfig.tools.json",
    "build": "npm run tools:compile && node dist/scripts/build.js",
    "build:clean": "npm run tools:compile && node dist/scripts/build.js --clean",
    "clean": "node scripts/clean.js",
    "clean:apply": "node scripts/clean.js --apply",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.tools.json",
    "test": "npm run build && node --import ./test/env.js --test --test-timeout=120000 dist/test/benchmarks.test.js test/*.test.js test/providers/*.test.js test/providers/e2e/*.test.js",
    "test:browser": "npm run build && playwright test",
    "format": "prettier --write src web scripts test package.json tsconfig.json .github/workflows/*.yml .prettierrc.json eslint.config.js *.md skills/**/*.md",
    "format:check": "prettier --check src web scripts test package.json tsconfig.json .github/workflows/*.yml .prettierrc.json eslint.config.js *.md skills/**/*.md",
    "lint": "eslint src web scripts test",
    "check:skills": "npm run tools:compile && node dist/scripts/validate-skills.js",
    "evaluate:skills": "node scripts/skill-evaluations.js",
    "evaluate:requirement-change": "node scripts/requirement-change-evaluations.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run tools:compile && node dist/scripts/check.js",
    "verify:providers": "node scripts/provider-e2e.js",
    "verify:lifecycle": "node scripts/live-lifecycle-evidence.js",
    "verify:workflow": "node scripts/live-workflow-evidence.js",
    "smoke:artifact": "node scripts/artifact-smoke.js",
    "release:artifacts": "npm run build && node scripts/release-artifacts.js",
    "release:dry-run": "npm run build && node scripts/release-artifacts.js --dry-run",
    "smoke:bundle": "node scripts/bundle-smoke.js",
    "benchmark:baseline": "npm run build && node dist/scripts/benchmarks.js"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "antigravity-cli",
    "cursor",
    "windows",
    "developer-tools"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "lucide-react": "^1.41.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
