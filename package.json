{
  "name": "latchkit",
  "version": "0.1.0-alpha.1",
  "description": "Your agents. One workflow. Open-source skills and local configuration for coding agents.",
  "type": "module",
  "license": "MIT",
  "author": "Guilherme Jacob",
  "repository": {
    "type": "git",
    "url": "https://github.com/gjsoaresc/latchkit.git"
  },
  "bugs": "https://github.com/gjsoaresc/latchkit/issues",
  "homepage": "https://github.com/gjsoaresc/latchkit#readme",
  "bin": {
    "latchkit": "src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src/",
    "web/",
    "skills/",
    "schemas/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node src/cli.js ui",
    "test": "node --test test/*.test.js test/providers/*.test.js test/providers/e2e/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write src web scripts test package.json .github/workflows/*.yml .prettierrc.json eslint.config.js *.md skills/**/*.md",
    "format:check": "prettier --check src web scripts test package.json .github/workflows/*.yml .prettierrc.json eslint.config.js *.md skills/**/*.md",
    "lint": "eslint src web scripts test",
    "check:skills": "node scripts/validate-skills.js",
    "evaluate:skills": "node scripts/skill-evaluations.js",
    "check": "npm run format:check && npm run lint && node scripts/check.js",
    "verify:providers": "node scripts/provider-e2e.js",
    "verify:lifecycle": "node scripts/live-lifecycle-evidence.js",
    "smoke:artifact": "node scripts/artifact-smoke.js",
    "release:artifacts": "node scripts/release-artifacts.js",
    "release:dry-run": "node scripts/release-artifacts.js --dry-run"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "antigravity-cli",
    "cursor",
    "windows",
    "developer-tools"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}
